# Default text detection
* text=auto

# Source code and documentation
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.sql   text eol=lf
*.txt   text eol=lf

# Repository text files without typical extensions
.env.example text eol=lf
LICENSE      text eol=lf

# Harbor generated/baseline artifacts
.harbor/views/**    text eol=lf
.harbor/baseline/** text eol=lf

# Binary files
*.db     binary
*.sqlite binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.zip    binary
